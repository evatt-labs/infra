# Loaded by direnv when entering evattlabs-infra.
#
# Per ADR-0015: no plaintext secrets on disk.

# AWS profile for tofu's S3-backend writes against R2 (evattlabs-tfstate).
# Configured in ~/.aws/{config,credentials} as the 'r2' profile.
export AWS_PROFILE="r2"

ENV="${EVATTLABS_ENV:-dev}"
SECRETS_FILE="$PWD/secrets/${ENV}.enc.yaml"
if [[ -f "$SECRETS_FILE" ]]; then
    use sops_dotenv "$SECRETS_FILE"
fi
